{
  "manifest_version": 3,
  "name": "WAM Agent - Web Activity Monitor",
  "version": "0.1.0",
  "description": "Warns about possible phishing, insecure login pages, and cross-site forms. Checks page structure only - it never reads what you type.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WAM Agent"
  }
}
